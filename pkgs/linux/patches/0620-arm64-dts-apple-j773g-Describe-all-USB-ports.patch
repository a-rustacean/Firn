From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yureka Lilian <yureka@cyberchaos.dev>
Date: Fri, 20 Nov 2026 12:00:00 +0000
Subject: [PATCH] arm64: dts: apple: j773g: Describe all USB ports

Add the third rear Type-C connector and enable its controller, PHY and
DARTs. ATC2 connects the two front connectors through a fixed USB3 hub;
select host mode, the fixed PHY routing and the hub GPIOs.

Keep the corrected rear-right PD select interrupt (65) from Gravity
Linux. All enablement is board-local; the Air still has only ATC0/1.
Do not describe USB4 or DisplayPort alt mode without their drivers.

Based on Gravity Linux commits 90c750cab494 (USB nodes),
ac4004d11b55 (fixed hub wiring) and ab99a21459c8 (PD interrupt).
Signed-off-by: Yureka Lilian <yureka@cyberchaos.dev>
[Firn: retain only J773g wiring, enable controllers disabled by the
 existing series, and drop Type-C role switching on the fixed hub.]
Link: https://github.com/GravityLinux/linux/commit/90c750cab494023b1a36390dd7fd90be7b2c5ef5
Link: https://github.com/GravityLinux/linux/commit/ab99a21459c81c234a4d611505c9862e3b7026e0

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8132-j773g.dts | 146 ++++++++++++++++++++++++++++++
 1 file changed, 146 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j773g.dts b/arch/arm64/boot/dts/apple/t8132-j773g.dts
index 2466eea..c53a052 100644
--- a/arch/arm64/boot/dts/apple/t8132-j773g.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j773g.dts
@@ -33,6 +33,128 @@ &bluetooth0 {
 	brcm,board-type = "apple,sakhalin";
 };
 
+/* The two front connectors share a permanently attached USB3 hub. */
+&atcphy2 {
+	apple,fixed-usb3;
+	apple,fixed-lane-swap;
+	/delete-property/ orientation-switch;
+	/delete-property/ mode-switch;
+	status = "okay";
+};
+
+&atcphy3 {
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+
+			atcphy3_typec_lanes: endpoint {
+				remote-endpoint = <&typec3_connector_ss>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+
+			atcphy3_usb3: endpoint {
+				remote-endpoint = <&dwc3_3_ss>;
+			};
+		};
+	};
+};
+
+&dwc3_2 {
+	dr_mode = "host";
+	/delete-property/ usb-role-switch;
+	/delete-property/ role-switch-default-mode;
+	status = "okay";
+};
+
+&dwc3_2_dart_0 {
+	status = "okay";
+};
+
+&dwc3_2_dart_1 {
+	status = "okay";
+};
+
+&dwc3_3 {
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+
+			dwc3_3_hs: endpoint {
+				remote-endpoint = <&typec3_connector_hs>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+
+			dwc3_3_ss: endpoint {
+				remote-endpoint = <&atcphy3_usb3>;
+			};
+		};
+	};
+};
+
+&dwc3_3_dart_0 {
+	status = "okay";
+};
+
+&dwc3_3_dart_1 {
+	status = "okay";
+};
+
+&nub_spmi_a0 {
+	hpm3: usb-pd@8 {
+		compatible = "apple,sn201202x";
+		reg = <0x8 SPMI_USID>;
+		interrupts = <63 IRQ_TYPE_EDGE_RISING>,
+			     <65 IRQ_TYPE_EDGE_RISING>,
+			     <69 IRQ_TYPE_EDGE_RISING>,
+			     <71 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "irq", "select", "sleep", "wake";
+
+		typec3: connector {
+			compatible = "usb-c-connector";
+			label = "USB-C Back-right";
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					typec3_connector_hs: endpoint {
+						remote-endpoint = <&dwc3_3_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+
+					typec3_connector_ss: endpoint {
+						remote-endpoint = <&atcphy3_typec_lanes>;
+					};
+				};
+			};
+		};
+	};
+};
+
 &pcie0 {
 	iommu-map = <0x100 &pcie0_dart 1 1>,
 		    <0x200 &pcie2_dart 1 1>;
@@ -53,6 +175,30 @@ ethernet0: ethernet@0,0 {
 	};
 };
 
+&pinctrl_ap {
+	usb3hub-flash-oe-hog {
+		gpio-hog;
+		gpios = <101 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "usb3hub-flash-oe";
+	};
+
+	usb3hub-reset-hog {
+		gpio-hog;
+		gpios = <198 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "usb3hub-reset";
+	};
+};
+
+&typec0 {
+	label = "USB-C Back-middle";
+};
+
+&typec1 {
+	label = "USB-C Back-left";
+};
+
 &wifi0 {
 	brcm,board-type = "apple,sakhalin";
 };
