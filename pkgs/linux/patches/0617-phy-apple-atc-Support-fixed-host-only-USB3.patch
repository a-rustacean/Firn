From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Fri, 20 Nov 2026 12:00:00 +0000
Subject: [PATCH] phy: apple: atc: Support fixed host-only USB3 links

A permanently attached hub has no Type-C controller to select USB3 mode
or power up the USB2 PHY. Configure the lanes when the host requests
USB3 and bring up USB2 when releasing the DWC3 reset. Apply fixed lane
routing and do not register unused Type-C switches.

Imported from Gravity Linux commit
70bc0e4285f238f7bc6337f8b2a7af62a6b4a5bf.

Signed-off-by: Niklas Sheth <hi@niklassheth.com>
[Firn: rebase on the existing series; use the existing OF API; reject
 device mode on a host-only link and lane swaps without a fixed link.]
Link: https://github.com/GravityLinux/linux/commit/70bc0e4285f238f7bc6337f8b2a7af62a6b4a5bf

Assisted-by: LLM
---
 drivers/phy/apple/atc.c | 39 ++++++++++++++++++++++++++++++++-------
 1 file changed, 32 insertions(+), 7 deletions(-)

diff --git a/drivers/phy/apple/atc.c b/drivers/phy/apple/atc.c
index 7f541f0..f1d7427 100644
--- a/drivers/phy/apple/atc.c
+++ b/drivers/phy/apple/atc.c
@@ -616,6 +616,8 @@ struct atcphy_hw {
  * @swap_lanes: True if lanes must be swapped due to cable orientation
  * @dp_link_rate: DisplayPort link rate
  * @pipehandler_up: True if the PIPE mux ("pipehandler") is set to USB3 or USB4 mode
+ * @fixed_usb3: True for a permanently attached, host-only USB3 connection
+ * @fixed_lane_swap: True if a fixed USB3 connection uses the swapped orientation
  * @regs: Memory-mapped registers
  * @regs.core: Core registers
  * @regs.axi2af: AXI to Apple Fabric interface registers
@@ -650,6 +652,8 @@ struct apple_atcphy {
 	int dp_link_rate;
 	bool swap_lanes;
 	bool pipehandler_up;
+	bool fixed_usb3;
+	bool fixed_lane_swap;
 
 	struct {
 		void __iomem *core;
@@ -1323,7 +1327,7 @@ static void atcphy_configure_lanes(struct apple_atcphy *atcphy, enum atcphy_mode
 	core_mask32(atcphy, atcphy->hw->aciophy_crossbar, ACIOPHY_CROSSBAR_PROTOCOL,
 		    FIELD_PREP(ACIOPHY_CROSSBAR_PROTOCOL, mode_cfg->crossbar));
 
-	if (mode_cfg->set_swap)
+	if (mode_cfg->set_swap || atcphy->fixed_lane_swap)
 		core_set32(atcphy, ATCPHY_MISC, ATCPHY_MISC_LANE_SWAP);
 	else
 		core_clear32(atcphy, ATCPHY_MISC, ATCPHY_MISC_LANE_SWAP);
@@ -2032,9 +2036,13 @@ static int atcphy_usb3_power_off(struct phy *phy)
 static int atcphy_usb3_set_mode(struct phy *phy, enum phy_mode mode, int submode)
 {
 	struct apple_atcphy *atcphy = phy_get_drvdata(phy);
+	int ret;
 
 	guard(mutex)(&atcphy->lock);
 
+	if (atcphy->fixed_usb3 && mode != PHY_MODE_USB_HOST)
+		return -EINVAL;
+
 	/*
 	 * We may get multiple calls to set_mode (for host mode e.g. at least one from the dwc3 glue
 	 * driver and then another one from the generic xhci code) but must only configure the
@@ -2043,6 +2051,12 @@ static int atcphy_usb3_set_mode(struct phy *phy, enum phy_mode mode, int submode
 	if (atcphy->pipehandler_up)
 		return 0;
 
+	if (atcphy->fixed_usb3 && atcphy->mode == APPLE_ATCPHY_MODE_OFF) {
+		ret = atcphy_configure(atcphy, APPLE_ATCPHY_MODE_USB3);
+		if (ret)
+			return ret;
+	}
+
 	switch (mode) {
 	case PHY_MODE_USB_HOST:
 		return atcphy_configure_pipehandler(atcphy, true);
@@ -2213,6 +2227,11 @@ static int atcphy_dwc3_reset_deassert(struct reset_controller_dev *rcdev, unsign
 
 	guard(mutex)(&atcphy->lock);
 
+	if (atcphy->fixed_usb3) {
+		atcphy_usb2_power_on(atcphy);
+		set32(atcphy->regs.usb2phy + USB2PHY_SIG, USB2PHY_SIG_HOST);
+	}
+
 	clear32(atcphy->regs.pipehandler + PIPEHANDLER_AON_GEN,
 		PIPEHANDLER_AON_GEN_DWC3_FORCE_CLAMP_EN);
 	set32(atcphy->regs.pipehandler + PIPEHANDLER_AON_GEN, PIPEHANDLER_AON_GEN_DWC3_RESET_N);
@@ -2460,12 +2479,14 @@ static int atcphy_probe_finalize(struct apple_atcphy *atcphy)
 	ret = atcphy_probe_rcdev(atcphy);
 	if (ret)
 		return dev_err_probe(atcphy->dev, ret, "Probing rcdev failed");
-	ret = atcphy_probe_mux(atcphy);
-	if (ret)
-		return dev_err_probe(atcphy->dev, ret, "Probing mux failed");
-	ret = atcphy_probe_switch(atcphy);
-	if (ret)
-		return dev_err_probe(atcphy->dev, ret, "Probing switch failed");
+	if (!atcphy->fixed_usb3) {
+		ret = atcphy_probe_mux(atcphy);
+		if (ret)
+			return dev_err_probe(atcphy->dev, ret, "Probing mux failed");
+		ret = atcphy_probe_switch(atcphy);
+		if (ret)
+			return dev_err_probe(atcphy->dev, ret, "Probing switch failed");
+	}
 	ret = atcphy_probe_phy(atcphy);
 	if (ret)
 		return dev_err_probe(atcphy->dev, ret, "Probing phy failed");
@@ -2501,6 +2522,10 @@ static int atcphy_probe(struct platform_device *pdev)
 
 	atcphy->mode = APPLE_ATCPHY_MODE_OFF;
 	atcphy->pipehandler_up = false;
+	atcphy->fixed_usb3 = of_property_read_bool(dev->of_node, "apple,fixed-usb3");
+	atcphy->fixed_lane_swap = of_property_read_bool(dev->of_node, "apple,fixed-lane-swap");
+	if (atcphy->fixed_lane_swap && !atcphy->fixed_usb3)
+		return dev_err_probe(dev, -EINVAL, "Lane swap requires a fixed USB3 connection\n");
 
 	return atcphy_probe_finalize(atcphy);
 }
