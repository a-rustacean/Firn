From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Fri, 20 Nov 2026 12:00:00 +0000
Subject: [PATCH] usb: dwc3: apple: Start fixed host controllers at probe

A permanently attached hub cannot generate a Type-C cable event. Start
controllers described with dr_mode = "host" during probe, selecting
the host role before the core reset so the unused gadget side is not
reset. Do not register a role switch for this fixed connection.

Imported from Gravity Linux commit
0b865ed5d9e647dd75822b64f56be9495fae72d5.
Signed-off-by: Niklas Sheth <hi@niklassheth.com>
[Firn: omit unrelated ep0.c whitespace changes; clarify the fixed-link
 comment. Keep Type-C controllers on their existing cable-event path.]
Link: https://github.com/GravityLinux/linux/commit/0b865ed5d9e647dd75822b64f56be9495fae72d5

Assisted-by: LLM
---
 drivers/usb/dwc3/dwc3-apple.c | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/drivers/usb/dwc3/dwc3-apple.c b/drivers/usb/dwc3/dwc3-apple.c
index 40c3ccf..730a2bf 100644
--- a/drivers/usb/dwc3/dwc3-apple.c
+++ b/drivers/usb/dwc3/dwc3-apple.c
@@ -436,6 +436,7 @@ static int dwc3_apple_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
 	struct dwc3_apple *appledwc;
+	enum usb_dr_mode dr_mode;
 	int ret;
 
 	appledwc = devm_kzalloc(&pdev->dev, sizeof(*appledwc), GFP_KERNEL);
@@ -444,6 +445,8 @@ static int dwc3_apple_probe(struct platform_device *pdev)
 
 	appledwc->dev = &pdev->dev;
 	mutex_init(&appledwc->lock);
+	dr_mode = usb_get_dr_mode(dev);
+	appledwc->dwc.dr_mode = dr_mode;
 
 	appledwc->reset = devm_reset_control_get_exclusive(dev, NULL);
 	if (IS_ERR(appledwc->reset))
@@ -475,6 +478,20 @@ static int dwc3_apple_probe(struct platform_device *pdev)
 	 * details.
 	 */
 	appledwc->state = DWC3_APPLE_PROBE_PENDING;
+	if (dr_mode == USB_DR_MODE_HOST) {
+		/*
+		 * Fixed host links have no Type-C cable event to start the core.
+		 * Select the host role before probing so the core does not reset
+		 * the unused gadget side of the controller.
+		 */
+		appledwc->dwc.current_dr_role = DWC3_GCTL_PRTCAP_HOST;
+		guard(mutex)(&appledwc->lock);
+		ret = dwc3_apple_init(appledwc, DWC3_APPLE_HOST);
+		if (ret)
+			return dev_err_probe(dev, ret, "Failed to start fixed host controller\n");
+		return 0;
+	}
+
 	ret = dwc3_apple_setup_role_switch(appledwc);
 	if (ret)
 		return dev_err_probe(&pdev->dev, ret, "Failed to setup role switch\n");
@@ -489,7 +506,8 @@ static void dwc3_apple_remove(struct platform_device *pdev)
 
 	guard(mutex)(&appledwc->lock);
 
-	usb_role_switch_unregister(appledwc->role_sw);
+	if (appledwc->role_sw)
+		usb_role_switch_unregister(appledwc->role_sw);
 
 	/*
 	 * If we're still in DWC3_APPLE_PROBE_PENDING we never got any cable connected event and
