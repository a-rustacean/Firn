From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Fri, 20 Nov 2026 12:00:00 +0000
Subject: [PATCH] arm64: dts: apple: j773g: Enable the HDMI display

Connect the main DCP to the internal DisplayPort-to-HDMI bridge through
the T8132 DPTX PHY. Describe the bridge power GPIOs and the two supported
scanout surfaces, and enable the display DARTs and mailbox.

Reuse the shared display nodes and existing T8132 DCP/PHY drivers. Do
not enable the external DCPs, audio or the experimental fixed-DP driver.

Derived from Gravity Linux commit
ac4004d11b55d4d37e64df7aca6487d949d785b2 (devicetree part of
877c574dfa4f31434129b05da6d907abfb21bbef).
Signed-off-by: Niklas Sheth <hi@niklassheth.com>
[Firn: board enablement only; keep the shared SoC nodes unchanged.]
Link: https://github.com/GravityLinux/linux/commit/ac4004d11b55d4d37e64df7aca6487d949d785b2

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8132-j773g.dts | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j773g.dts b/arch/arm64/boot/dts/apple/t8132-j773g.dts
index c53a052..aa4dfa8 100644
--- a/arch/arm64/boot/dts/apple/t8132-j773g.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j773g.dts
@@ -33,6 +33,35 @@ &bluetooth0 {
 	brcm,board-type = "apple,sakhalin";
 };
 
+&dcp {
+	apple,connector-type = "HDMI-A";
+	apple,iomfb-surfaces = <1 1 0 0>;
+	apple,iomfb-surface-order = <0 1>;
+	apple,iomfb-primary-surface = <0>;
+	phys = <&dptxphy>;
+	phy-names = "dp-phy";
+	apple,dptx-phy = <4>;
+	hdmi-pwren-gpios = <&smc_gpio 15 GPIO_ACTIVE_HIGH>;
+	dp2hdmi-pwren-gpios = <&smc_gpio 26 GPIO_ACTIVE_HIGH>;
+	status = "okay";
+};
+
+&dcp_dart {
+	status = "okay";
+};
+
+&dcp_mbox {
+	status = "okay";
+};
+
+&disp0_dart {
+	status = "okay";
+};
+
+&dptxphy {
+	status = "okay";
+};
+
 /* The two front connectors share a permanently attached USB3 hub. */
 &atcphy2 {
 	apple,fixed-usb3;
